{
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run build:release",
    "build:master": "node build/pre-build.js && vite build --mode master && node build/post-build.js",
    "build:release": "node build/pre-build.js && vite build && node build/post-build.js",
    "build:steam-development": "node build/pre-build.js && vite build --mode steam-development",
    "build:steam-release": "node build/pre-build.js && vite build --mode steam-release",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint --ext .js,.mjs,.vue src build vite.config.mjs"
  },
  "dependencies": {
    "@antimatter-dimensions/notations": "^3.1.0",
    "@fortawesome/fontawesome-free": "^6.1.1",
    "adnot-beport-large": "^1.2.0",
    "adnot-beport-small": "^1.1.3",
    "break_eternity.js": "^1.4.1",
    "chevrotain": "^4.8.1",
    "codemirror": "^5.65.1",
    "core-js": "^3.6.5",
    "drag-drop-touch": "^1.3.1",
    "firebase": "^9.6.6",
    "gamma": "^1.0.0",
    "js-sha512": "^0.8.0",
    "jsmin": "^1.0.1",
    "lodash": "^4.17.21",
    "memfs": "^4.2.0",
    "mousetrap": "^1.6.5",
    "pako": "^2.0.4",
    "svg-pan-zoom": "^3.6.1",
    "tween.js": "^16.6.0",
    "uuid": "^8.0.0",
    "v-tooltip": "^2.1.3",
    "vis-network": "^5.1.1",
    "vis-util": "^4.3.4",
    "vue": "2.7.16",
    "vue-gtag": "^1.16.1",
    "vue-loading-overlay": "^3.4.2",
    "vue-splitpane": "^1.0.6",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "browserslist-useragent-regexp": "^3.0.2",
    "eslint": "^7.20.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-vue": "^8.0.3",
    "postcss-html": "^1.4.1",
    "stylelint": "^14.8.2",
    "stylelint-config-html": "1.1.0",
